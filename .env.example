# Google Analytics is NOT configured here. The GA4 measurement ID lives in
# src/ga.config.ts — it is a public identifier, committed like the sibling
# sites' config.js, so every deployment reports without extra setup.

# Canonical site URL used for SEO metadata, sitemap, robots.txt and JSON-LD.
#
# Set this only when the site has its own domain. On Vercel it can be left
# empty: the deployment falls back to its own production URL, and a branch
# preview to that preview's URL. See src/lib/siteUrl.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
